# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# Viac schránok naraz: vytvorte accounts.ini (pozri accounts.ini.example).
# IMAP_* nižšie sa použije len ak accounts.ini neexistuje.
# ACCOUNTS_FILE=accounts.ini

# IMAP — čítanie pošty (pre Gmail použite App Password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=obchod@example.sk
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# SMTP — odosielanie upozornení
# Pozn.: cloud servery (Hetzner...) často blokujú port 465 — použite 587 (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=obchod@example.sk
SMTP_PASSWORD=

# Kam posielať upozornenia (predvolene IMAP_USER)
REMINDER_TO=

# Koľko dní dopredu pripomínať splatnosti
REMINDER_DAYS_AHEAD=7

# Koľko dní dozadu prehľadávať poštu pri fetch
EMAIL_LOOKBACK_DAYS=7

# Heslá na odomknutie chránených PDF príloh (bankové výpisy, poistky...).
# Viac hesiel oddeľte čiarkou — skúšajú sa postupne.
PDF_PASSWORDS=

# Cesta k databáze
DB_PATH=bill_agent.db

# --- Onward (letové rezervácie bez platby, pozri ONWARD.md) ---
# DUFFEL_API_KEY=duffel_test_...
# ONWARD_BRAND=ValidFlight
# ONWARD_BASE_URL=https://validflight.com
# ONWARD_PRICE_EUR=9.90
# ONWARD_PRICE_WEEK_EUR=16.90
# ONWARD_PRICE_2WEEK_EUR=24.90
# ONWARD_DB_PATH=onward.db
# STRIPE_LINK_ONWARD=
# STRIPE_LINK_ONWARD_WEEK=
# STRIPE_LINK_ONWARD_2WEEK=
# STRIPE_LINK_ONWARD_HOTEL=   # hotelová rezervácia (Stays); bez neho sa rezervuje rovno
# ONWARD_STRIPE_WEBHOOK_SECRET=
# --- Krypto platby ---
# NOWPayments (podporuje XMR, ZEC, BTC, ETH, USDT... 300+ mincí):
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Coinbase Commerce (alternatíva, bez XMR/ZEC):
# COINBASE_COMMERCE_API_KEY=
# ONWARD_COINBASE_WEBHOOK_SECRET=
# ONWARD_ADMIN_KEY=
# ONWARD_SECRET=            # podpis session cookie účtov (dlhý náhodný reťazec)
# ONWARD_DATA_KEY=          # Fernet kľúč na šifrovanie čísla pasu; bez neho sa pasy neukladajú
#                           # vygeneruj: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Cloudflare Turnstile (voliteľná CAPTCHA zadarmo pri registrácii/prihlásení)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# ONWARD_SMTP_HOST=
# ONWARD_SMTP_PORT=587
# ONWARD_SMTP_USER=
# ONWARD_SMTP_PASSWORD=

# --- Onward: ostrý režim a prevádzka (september 2026) ---
# Ostrý režim = DUFFEL_API_KEY začína duffel_live_. Vtedy appka NENAŠTARTUJE bez:
#   ONWARD_SECRET (min. 32 znakov), všetkých STRIPE_LINK_ONWARD* vrátane hotela
#   a ONWARD_STRIPE_WEBHOOK_SECRET. S testovacím kľúčom web všade hlási TEST MODE.
# STRIPE_LINK_ONWARD_HOTEL=https://buy.stripe.com/...
# ONWARD_PRICE_HOTEL_EUR=14.90     # musí sedieť so sumou v Stripe linku hotela
# Stripe webhook: udalosti checkout.session.completed,
#   checkout.session.async_payment_succeeded, charge.refunded, charge.dispute.created
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# ONWARD_CONTACT_EMAIL=support@validflight.com
# ONWARD_ALERT_EMAIL=support@validflight.com   # hlásenia o zlyhaných platených objednávkach
# ONWARD_RETENTION_DAYS=365                    # po koľkých dňoch sa mažú uzavreté objednávky

# --- Onward: prihlásenie, e-maily, monitoring, hotely (september 2026) ---
# Google prihlásenie: OAuth klient typu „Web application“,
# redirect URI {ONWARD_BASE_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Transakčné e-maily (napr. Brevo): host smtp-relay.brevo.com, port 587
# ONWARD_SMTP_FROM=ValidFlight <noreply@validflight.com>
# Kontrola uniknutých hesiel (Have I Been Pwned), 0 = vypnúť
# ONWARD_HIBP=1
# Hlásenie chýb
# SENTRY_DSN=
# Štatistiky Umami (bez cookies)
# ONWARD_UMAMI_SRC=https://stat.depesa.sk/s.js
# ONWARD_UMAMI_WEBSITE_ID=
# Vrátenie platby z adminu (obmedzený kľúč s Refunds: Write)
# STRIPE_SECRET_KEY=
# Hotely: poradie dodávateľov; bez nakonfigurovaného dodávateľa je stránka /hotel „čoskoro“
# ONWARD_HOTEL_PROVIDERS=ratehawk,hotelbeds
# ONWARD_HOTEL_MAX_TOTAL_EUR=800
# RATEHAWK_KEY_ID=
# RATEHAWK_API_KEY=
# RATEHAWK_BASE=https://api-sandbox.ratehawk.com
# HOTELBEDS_API_KEY=
# HOTELBEDS_SECRET=
# HOTELBEDS_CERT_FILE=/opt/validflight/hotelbeds-client.pem
# HOTELBEDS_KEY_FILE=/opt/validflight/hotelbeds-client.key
# ONWARD_SERVER_IP=195.201.147.90
