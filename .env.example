# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-8

# Viac schránok naraz: vytvorte accounts.ini (pozri accounts.ini.example).
# IMAP_* nižšie sa použije len ak accounts.ini neexistuje.
# ACCOUNTS_FILE=accounts.ini

# IMAP — čítanie pošty (pre Gmail použite App Password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=obchod@example.sk
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# SMTP — odosielanie upozornení
# Pozn.: cloud servery (Hetzner...) často blokujú port 465 — použite 587 (STARTTLS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=obchod@example.sk
SMTP_PASSWORD=

# Kam posielať upozornenia (predvolene IMAP_USER)
REMINDER_TO=

# Koľko dní dopredu pripomínať splatnosti
REMINDER_DAYS_AHEAD=7

# Koľko dní dozadu prehľadávať poštu pri fetch
EMAIL_LOOKBACK_DAYS=7

# Heslá na odomknutie chránených PDF príloh (bankové výpisy, poistky...).
# Viac hesiel oddeľte čiarkou — skúšajú sa postupne.
PDF_PASSWORDS=

# Cesta k databáze
DB_PATH=bill_agent.db

# --- Onward (letové rezervácie bez platby, pozri ONWARD.md) ---
# DUFFEL_API_KEY=duffel_test_...
# ONWARD_BRAND=ValidFlight
# ONWARD_BASE_URL=https://validflight.com
# ONWARD_PRICE_EUR=9.90
# ONWARD_PRICE_WEEK_EUR=16.90
# ONWARD_PRICE_2WEEK_EUR=24.90
# ONWARD_DB_PATH=onward.db
# STRIPE_LINK_ONWARD=
# STRIPE_LINK_ONWARD_WEEK=
# STRIPE_LINK_ONWARD_2WEEK=
# STRIPE_LINK_ONWARD_HOTEL=   # hotelová rezervácia (Stays); bez neho sa rezervuje rovno
# ONWARD_STRIPE_WEBHOOK_SECRET=
# --- Krypto platby ---
# NOWPayments (podporuje XMR, ZEC, BTC, ETH, USDT... 300+ mincí):
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Coinbase Commerce (alternatíva, bez XMR/ZEC):
# COINBASE_COMMERCE_API_KEY=
# ONWARD_COINBASE_WEBHOOK_SECRET=
# ONWARD_ADMIN_KEY=
# ONWARD_SECRET=            # podpis session cookie účtov (dlhý náhodný reťazec)
# ONWARD_DATA_KEY=          # Fernet kľúč na šifrovanie čísla pasu; bez neho sa pasy neukladajú
#                           # vygeneruj: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Cloudflare Turnstile (voliteľná CAPTCHA zadarmo pri registrácii/prihlásení)
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# ONWARD_SMTP_HOST=
# ONWARD_SMTP_PORT=587
# ONWARD_SMTP_USER=
# ONWARD_SMTP_PASSWORD=
