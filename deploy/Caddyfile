# Reverse proxy s automatickým HTTPS (Let's Encrypt).
# Na server ho vkladá deploy/caddy_validflight.py (nahradí blok validflight).
www.validflight.com {
    redir https://validflight.com{uri} permanent
}

validflight.com {
    encode zstd gzip

    # dokumentácia API sa nezverejňuje (appka ju má vypnutú, toto je poistka)
    @apidocs path /docs /docs/* /redoc /openapi.json
    respond @apidocs 404

    header -Server

    # Skutočná IP návštevníka pre limity pokusov. Požiadavke z adries Cloudflare
    # veríme CF-Connecting-IP; komukoľvek inému len jeho vlastnú adresu, takže
    # sa hlavička nedá podvrhnúť priamym prístupom na server.
    # Rozsahy: https://www.cloudflare.com/ips/ (overené 15. 9. 2026)
    @cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    handle @cloudflare {
        reverse_proxy 127.0.0.1:8100 {
            header_up X-Real-IP {http.request.header.CF-Connecting-IP}
            header_down -Server
        }
    }
    handle {
        reverse_proxy 127.0.0.1:8100 {
            header_up X-Real-IP {remote_host}
            header_down -Server
        }
    }
}
