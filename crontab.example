# Odporúčaný cron pre server so SaaS režimom (run-all + web).
# Časy sú v CRON_TZ — nastavte na začiatok crontabu:
# CRON_TZ=Europe/Bratislava

# Sťahovanie pošty všetkých klientov (spracuje aj odpovede "zaplatené 3")
*/30 7-19 * * *  cd /root/TMB && .venv/bin/python -m bill_agent run-all fetch >> agent.log 2>&1

# Preposielacia schránka (ak je nastavená FORWARD_IMAP_* v .env.master)
25,55 7-19 * * *  cd /root/TMB && .venv/bin/python -m bill_agent intake >> agent.log 2>&1

# Odosielanie e-mailov podľa rozvrhu každého klienta (nastavenia na webe):
# ranné prehľady, zhrnutia dňa/týždňa aj mesačné reporty
5 5-21 * * *  cd /root/TMB && .venv/bin/python -m bill_agent run-all notify >> agent.log 2>&1

# Vypnutie klientov s vypršaným trialom
15 4 * * *    cd /root/TMB && .venv/bin/python -m webapp.expire >> agent.log 2>&1

# Denná záloha dát (clients/, webapp.db, .env.master) do /root/backups
45 3 * * *    /root/TMB/scripts/backup.sh >> /root/TMB/agent.log 2>&1

# Sebakontrola servera — web beží? cron je čerstvý? disk má miesto?
# (Zapisuje do selfcheck.log, NIE do agent.log — inak by si sama „omladzovala“
#  agent.log a kontrola čerstvosti cronu by nikdy nezlyhala.)
*/15 * * * *  cd /root/TMB && .venv/bin/python -m webapp.selfcheck >> selfcheck.log 2>&1

# --- Jednoduchý režim bez SaaS (jeden používateľ, bez clients/) ---
# 30 7 * * 1-5  cd /cesta/k/TMB && .venv/bin/python -m bill_agent run >> agent.log 2>&1
# 30 17 * * 1-5 cd /cesta/k/TMB && .venv/bin/python -m bill_agent digest --days 1 >> agent.log 2>&1
